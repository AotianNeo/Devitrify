#!/bin/sh
# Runs at login. Applies the 33pt Solarium menu bar height in WindowServer, injects Devitrify
# into every app launched from now on, then relaunches Control Center, Notification Center,
# Spotlight (Siri AI / campo), and Rectangle if already started before the menu bar patch.

/bin/launchctl setenv DYLD_INSERT_LIBRARIES /Users/Shared/.devitrify/libDevitrify.dylib
if [ -x /Users/Shared/.devitrify/devitrify-menubar ]; then
    ws_before=$(/usr/bin/pgrep -x WindowServer)
    /Users/Shared/.devitrify/devitrify-menubar >/dev/null 2>&1
    /bin/sleep 0.5
    ws_after=$(/usr/bin/pgrep -x WindowServer)
    if [ -z "$ws_after" ] || [ "$ws_before" != "$ws_after" ]; then
        /bin/sleep 1.5
        /Users/Shared/.devitrify/devitrify-menubar >/dev/null 2>&1
    fi
fi
/bin/launchctl kickstart -k "gui/$(id -u)/com.apple.controlcenter"
/bin/launchctl kickstart -k "gui/$(id -u)/com.apple.notificationcenterui.agent"
/bin/launchctl kickstart -k "gui/$(id -u)/com.apple.campo" 2>/dev/null || true
/bin/launchctl kickstart -k "gui/$(id -u)/com.apple.Spotlight" 2>/dev/null || true
if /usr/bin/pgrep -x Rectangle >/dev/null 2>&1; then
    /usr/bin/killall Rectangle >/dev/null 2>&1 && /usr/bin/open -g -a Rectangle
fi
