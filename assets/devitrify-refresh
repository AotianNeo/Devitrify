#!/bin/sh
# Live-injects DevitrifyCore.dylib into running apps and system UI services that were
# started before Devitrify was loaded, and hot-reloads already-injected processes without
# restarting any app or service.

INSTALL_DIR=/Users/Shared/.devitrify

if [ "$1" = "-n" ] || [ "$1" = "--status" ] || [ "$1" = "status" ]; then
    exec "$INSTALL_DIR/devitrify-reload" --status
fi

exec "$INSTALL_DIR/devitrify-reload" "$@"
